{
  "name": "@bizgold/server",
  "private": true,
  "version": "1.0.0",
  "description": "金策 BizGold 服务端：Fastify API + Claude Agent SDK 运行器",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "archiver": "^8.0.0",
    "fastify": "^5.12.7",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
