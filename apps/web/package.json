{
  "name": "@bizgold/web",
  "private": true,
  "version": "1.0.0",
  "description": "金策 BizGold 前端工作台（React 18 + Vite 5 + Tailwind CSS 3）",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
